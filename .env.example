# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามต้องการ
# cp .env.example .env

# ---- PostgreSQL ----
POSTGRES_USER=project_user
POSTGRES_PASSWORD=project_pass
POSTGRES_DB=project_db

# ---- pgAdmin ----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ---- FastAPI / JWT ----
# เปลี่ยน SECRET_KEY เป็นค่าสุ่มที่คาดเดายากก่อนใช้งานจริงเสมอ
# สร้างได้ด้วยคำสั่ง: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- บัญชีนิติบุคคล (ผู้ดูแลหอ) ----
# สร้างให้อัตโนมัติตอน API เริ่มทำงาน ถ้ามีบัญชีชื่อนี้อยู่แล้วจะแค่ให้สิทธิ์นิติ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
